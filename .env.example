# Địa chỉ máy chủ API của backend (KTM_Market_BE).
# Bắt buộc phải có: giao diện KHÔNG còn dùng giá trị dự phòng nào, thiếu biến này thì mọi request
# sẽ hỏng (xem ghi chú trong src/services/apiClient.js).
#
# Cách dùng: sao chép file này thành `.env` rồi sửa giá trị cho đúng môi trường.
PUBLIC_API_URL=http://localhost:5151
